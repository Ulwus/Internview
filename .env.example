COMPOSE_PROJECT_NAME=internview

# Network
DOCKER_NETWORK=internview-net

# PostgreSQL
POSTGRES_DB=internview
POSTGRES_USER=internview
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_CLUSTER_ID=abcdefghijklmnopqrstuv
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Consul
CONSUL_HTTP_ADDR=http://consul:8500

# TURN/STUN (Coturn)
TURN_SECRET=CHANGE_ME_TURN_SECRET

# Mediasoup (Media Server)
MEDIA_SERVER_PORT=3000
MEDIA_SERVER_LOG_LEVEL=info
# Opsiyonel fallback. Normalde client'ın bağlandığı host otomatik kullanılır.
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40099
MEDIASOUP_LOG_LEVEL=warn
RECORDING_SEGMENT_SECONDS=10

# MinIO (S3 uyumlu object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_REGION=us-east-1
S3_BUCKET=internview-recordings

# AI Analysis Service
WHISPER_MODEL=small
WHISPER_LANGUAGE=tr
PRELOAD_WHISPER_MODEL=false
WHISPER_CACHE_HOST_DIR=/Volumes/M2SSD/internview/whisper-cache
ENABLE_KAFKA_CONSUMER=true
AI_ANALYSIS_WORK_DIR=/tmp/internview-ai-analysis
RECORDING_SEGMENTS_TOPIC=recording-segments
ENABLE_LLM_EVALUATION=true
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY

